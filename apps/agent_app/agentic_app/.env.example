# CockroachDB Cloud — managed cluster the memory adapter connects to.
# COCKROARCH_DB_SSLROOTCERT must point at a real CA bundle; the CockroachDB
# Cloud cluster uses Let's Encrypt, so the ISRG Root X1/X2 PEMs work
# (see infra/cockroach-labs-cloud-ca.cert.pem).
COCKROARCH_DB_HOST=
COCKROARCH_DB_PORT=26257
COCKROARCH_DB_NAME=defaultdb
COCKROARCH_USER=
COCKROARCH_DB_PASS=
COCKROARCH_DB_SSLMODE=verify-full
COCKROARCH_DB_SSLROOTCERT=infra/cockroach-labs-cloud-ca.cert.pem

# LLM + embeddings — OpenAI-compatible endpoint (DashScope/Qwen by default).
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

# AWS — for the observability tool (CloudWatch logs + metrics of the target app).
# Read by the CloudWatch adapter via boto3's default credential/region chain —
# there is no custom credential-loading path, so these standard vars are enough
# for local dev (on Lambda/ECS the ambient IAM role is used instead and these
# are ignored). Leave blank when you don't want the agent reading CloudWatch;
# the observe step then degrades to empty evidence and the rest still works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
