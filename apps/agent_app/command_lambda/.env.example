# --- Lambda runtime environment (set by SAM template / provided to handler) ---

# URL of the standard SQS queue the Lambda enqueues run jobs onto.
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/incident-pilot-runs

# ARN of that queue — used to scope the boto3 client region/account and for IAM.
SQS_QUEUE_ARN=arn:aws:sqs:us-east-1:000000000000:incident-pilot-runs

# AWS region for the SQS client. Defaults to AWS_REGION (Lambda runtime) when unset.
AWS_REGION=us-east-1
